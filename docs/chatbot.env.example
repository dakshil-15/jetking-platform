# ---------------------------------------------------------------------------
# Jetking Assistant — configuration
#
# Copy to `.env.local` and edit. Every value below is optional: the defaults
# shown are what the app uses when the variable is unset, so a fresh clone runs
# with no .env file at all.
#
#   cp .env.example .env.local
# ---------------------------------------------------------------------------

# --- Public (inlined into the browser bundle — never put secrets here) ------

# Origin of the Jetking website that answers link out to. The knowledge base
# stores relative paths only; this is what they are joined onto at render time.
NEXT_PUBLIC_SITE_URL=https://www.jetking.com

# Click-to-chat contact. Number is international format, digits only.
NEXT_PUBLIC_WHATSAPP_NUMBER=919999999999
NEXT_PUBLIC_WHATSAPP_MESSAGE=Hi Jetking, I have a question about your courses

# --- Answer generation (server only) ---------------------------------------

# Local Ollama server used to write the final reply. When it is unreachable the
# route falls back to returning the retrieved passage verbatim, so the
# assistant still answers — it just sounds less conversational.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=jetking-assistant

# When retrieval finds no verified Jetking content, let the local model answer
# from its general knowledge. Jetking-specific claims remain KB-only.
JK_ALLOW_GENERAL_ANSWERS=true

# --- Retrieval tuning (server only) ----------------------------------------

# Minimum cosine similarity before the assistant answers at all. Below this it
# says it does not know rather than guessing. Raise to be stricter.
JK_ANSWER_GATE=0.42

# Sentence-transformer for both indexing and querying. Changing this REQUIRES
# rebuilding the index (`npm run build:index -- --embed`); vectors from a
# different model are not comparable.
JK_EMBED_MODEL=Xenova/paraphrase-multilingual-MiniLM-L12-v2

# How far the BM25 signal may move a dense result. Tuned against
# `npm run eval:retrieval`: 0.05–0.12 all score 100%, above ~0.18 long
# boilerplate pages start outranking real answers.
JK_LEXICAL_WEIGHT=0.08
JK_LEXICAL_DEPTH=25

# Boost for a centre row whose city the question names. Large on purpose — every
# "Jetking centre in X" row is the same sentence with one word changed, so
# nothing short of an entity match separates Kolkata from Kanpur.
JK_CITY_BOOST=0.2

# --- Content sync (scripts only) -------------------------------------------

# Origin the crawler reads from. Point at a local mirror during development or
# at the live site to refresh: JK_ORIGIN=https://www.jetking.com npm run sync:content
JK_ORIGIN=http://localhost:3000

# Politeness. Defaults adapt to the origin: local is crawled hard, remote is
# throttled to one request every 2.5s because jetking.com rate-limits quickly.
# JK_CONCURRENCY=1
# JK_DELAY_MS=2500
# JK_TIMEOUT_MS=30000
# JK_MAX_ATTEMPTS=6
# JK_CACHE_TTL_MS=86400000

# Refuse to overwrite the committed knowledge base if a crawl returns less than
# this share of the previous run — stops one bad run emptying the corpus.
# JK_REGRESSION_TOLERANCE=0.6

# Embedding batch settings. Dimension must match the model above.
# JK_EMBED_DIM=384
# JK_EMBED_BATCH=64

# --- Deployment: retrieval mode --------------------------------------------
#
# The embedding model cannot be deployed to a standard serverless function:
# the quantised weights are 130 MB and onnxruntime-node another 92 MB, against
# Vercel's 250 MB unzipped limit. Nothing is bundled, so on a cold start the
# library tries to download the weights and write them to a read-only
# filesystem, which throws — and the assistant answers nothing.
#
#   auto     (default) use the model when it loads, fall back to BM25 when it
#            does not. This is what makes the Vercel deployment work.
#   dense    require the model; a missing model is a loud error. Use locally
#            or on a host with enough room (Docker, a VM, Fly, Railway).
#   lexical  skip the model entirely — smallest and fastest cold start.
#
# Measured on scripts/eval-retrieval.mjs: dense 20/20, lexical 17/20. Lexical
# still refuses every off-topic question, so it degrades gracefully rather than
# inventing answers.
JK_RETRIEVAL_MODE=auto

# Calibration for lexical mode. Saturation maps a raw BM25 score onto 0..1 so
# it can share the confidence gate above; the floor keeps an exact city match
# confident even when few other terms hit.
# JK_LEXICAL_SATURATION=6
# JK_CITY_MATCH_FLOOR=0.6

# Abort the local LLM call after this long. On a host without Ollama the call
# fails fast and the route returns the retrieved passage instead.
# OLLAMA_TIMEOUT_MS=20000
