# ─── Site ──────────────────────────────────────────────────────────────────
# Absolute origin. Used for canonical URLs, sitemap, OG tags. Must be set in prod.
# Server-only (not exposed to browser).
SITE_URL=http://localhost:3000

# National enquiry line, E.164 (e.g. +912212345678). Unset => "call us" affordances
# link to /centres, whose pages carry each centre's own number.
# NEXT_PUBLIC_PHONE=

# ─── Persona engine ────────────────────────────────────────────────────────
# HMAC secret for signing the jk_persona cookie. Generate: openssl rand -hex 32
PERSONA_COOKIE_SECRET=dev-only-insecure-secret-replace-in-production

# ─── Content source ────────────────────────────────────────────────────────
# 'local' = repo fixtures. 'admin' = Admin Panel / Postgres (or file store).
CONTENT_SOURCE=local

# ─── Supabase (Admin CMS + pgvector) ───────────────────────────────────────
# When unset, Admin CMS uses the local file store under data/cms/.
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
# DATABASE_URL=

# ─── AI Guide ──────────────────────────────────────────────────────────────
# Absent key => Guide degrades to a deterministic counsellor-handoff / citation card.
OPENAI_API_KEY=
GUIDE_MODEL=gpt-4o
GUIDE_EMBEDDING_MODEL=text-embedding-3-small
GUIDE_ENABLED=true
# Optional: silent persona model (falls back to heuristic if unset / no key)
# PERSONA_INFER_MODEL=gpt-4o-mini
# REVALIDATE_SECRET=   # shared secret for /api/revalidate + ingest hooks

# ─── Analytics ─────────────────────────────────────────────────────────────
# NEXT_PUBLIC_GTM_ID=
# NEXT_PUBLIC_POSTHOG_KEY=
# NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# ─── Rate limiting ─────────────────────────────────────────────────────────
# Default 'memory' counts per process, so it under-limits on a multi-instance
# deployment. A production server REFUSES TO BOOT on 'memory' unless you set
# RATE_LIMIT_ALLOW_MEMORY=true — deploying single-instance is a valid choice, but
# it has to be a deliberate one.
# RATE_LIMIT_STORE=memory
# RATE_LIMIT_ALLOW_MEMORY=true

# ─── Enquiry / CRM ─────────────────────────────────────────────────────────
# Existing Jetking enquiry endpoint. Absent => enquiries are logged, not dropped.
# CRM_ENDPOINT=
# CRM_API_KEY=
NEXT_PUBLIC_WHATSAPP_NUMBER=

# ─── Admin ─────────────────────────────────────────────────────────────────
# Simple staff gate for /admin when Supabase Auth is not configured.
# ADMIN_PASSWORD=changeme

# ─── Jetking AI assistant ───────────────────────────────────────────────────
# The assistant works from its local knowledge base without Ollama. When an
# Ollama model is available, it can compose grounded answers from retrieved data.
NEXT_PUBLIC_WHATSAPP_MESSAGE=Hi, I would like to know more about Jetking courses.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=jetking-assistant
JK_ALLOW_GENERAL_ANSWERS=true
JK_ANSWER_GATE=0.42
JK_EMBED_MODEL=Xenova/paraphrase-multilingual-MiniLM-L12-v2
JK_LEXICAL_WEIGHT=0.08
JK_LEXICAL_DEPTH=25
JK_CITY_BOOST=0.2
JK_RETRIEVAL_MODE=auto
# JK_INDEX_PATH=
# OLLAMA_TIMEOUT_MS=20000
